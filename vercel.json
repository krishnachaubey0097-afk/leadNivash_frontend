{
  "rewrites": [
    {
      "source": "/:path(pricing|contact|privacy|terms|refund|cookies|login|register)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Embedly|Quora).*"
        }
      ],
      "destination": "/api/seo-meta?path=/:path"
    },
    {
      "source": "/flyer/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|Embedly|Quora).*"
        }
      ],
      "destination": "/api/seo-meta?path=/flyer/:id"
    },
    {
      "source": "/api/((?!seo-meta$).*)",
      "destination": "https://leadnivash.onrender.com/api/$1"
    },
    {
      "source": "/p/:path*",
      "destination": "https://leadnivash.onrender.com/p/:path*"
    },
    {
      "source": "/health",
      "destination": "https://leadnivash.onrender.com/health"
    },
    {
      "source": "/((?!api/|p/|health(?:$|/)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
